@@ -0,0 +1,127 @@
+/*---------------------------------------------------------------------------------------------
+ *  HypeProof Studio (REQ-STUDIO-TRUST-OWN-FOLDERS) - folders Studio itself created are trusted.
+ *  Pure decision, no imports: `workspaceTrust.ts` reads the raw inputs (the user-local setting, the
+ *  extension-disabled list, the chat extension's globalState record, the learner's "Don't Trust"
+ *  list, the folder's creation time) and hands them here. Every unreadable input means "prompt".
+ *--------------------------------------------------------------------------------------------*/
+
+/** Key inside the extension's globalState blob (`hypeproof.hypeproof-chat`). */
+export const HPS_STUDIO_FOLDERS_KEY = 'hypeproofChat.studioCreatedFolders';
+/** Machine-scope, default-off setting. The core reads the user-local value itself. */
+export const HPS_STUDIO_FLAG = 'hypeproofChat.trustStudioFolders';
+export const HPS_STUDIO_EXTENSION_ID = 'hypeproof.hypeproof-chat';
+/** Storage key (PROFILE and WORKSPACE scope) where the workbench keeps the disabled extension identifiers. */
+export const HPS_DISABLED_EXTENSIONS_KEY = 'extensionsIdentifiers/disabled';
+/** Application-scope list of folders the learner explicitly refused ("Don't Trust"). */
+export const HPS_STUDIO_DENIED_KEY = 'hypeproof.studioFolderTrustDenied';
+
+export interface IHpsStudioFolder {
+	/** Real path of the folder Studio created. */
+	readonly path: string;
+	/** Creation time (ms) of that folder when Studio made it; a delete + recreate changes it. */
+	readonly birth: number;
+}
+
+/** The creation record from the extension's stored globalState JSON; anything malformed is "no record". */
+export function hpsStudioFolderRecordOf(raw: string | undefined): readonly IHpsStudioFolder[] | undefined {
+	if (!raw) {
+		return undefined;
+	}
+	let record: { v?: unknown; folders?: unknown } | undefined;
+	try {
+		record = JSON.parse(raw)?.[HPS_STUDIO_FOLDERS_KEY];
+	} catch {
+		return undefined;
+	}
+	if (!record || record.v !== 2 || !Array.isArray(record.folders)) {
+		return undefined;
+	}
+	const folders: IHpsStudioFolder[] = [];
+	for (const entry of record.folders as { path?: unknown; birth?: unknown }[]) {
+		if (entry && typeof entry.path === 'string' && entry.path.length > 0 && typeof entry.birth === 'number' && Number.isFinite(entry.birth) && entry.birth > 0) {
+			folders.push({ path: entry.path, birth: entry.birth });
+		}
+	}
+	return folders;
+}
+
+/** True when the chat extension is disabled. An unreadable list counts as disabled (fail closed). */
+export function hpsExtensionDisabled(raw: string | undefined): boolean {
+	if (!raw) {
+		return false;
+	}
+	try {
+		const list = JSON.parse(raw);
+		return !Array.isArray(list) || list.some(e => typeof e?.id === 'string' && e.id.toLowerCase() === HPS_STUDIO_EXTENSION_ID);
+	} catch {
+		return true;
+	}
+}
+
+/** Paths the learner refused. undefined = unreadable (then nothing is trusted). */
+export function hpsDeniedOf(raw: string | undefined): readonly string[] | undefined {
+	if (!raw) {
+		return [];
+	}
+	try {
+		const list = JSON.parse(raw);
+		return Array.isArray(list) ? list.filter((p): p is string => typeof p === 'string' && p.length > 0) : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+const HPS_MAX_DENIED = 500;
+
+/** The denied list with `fsPath` added (an explicit "Don't Trust"). */
+export function hpsDeniedWith(raw: string | undefined, fsPath: string, isSamePath: (a: string, b: string) => boolean): string {
+	const list = [...(hpsDeniedOf(raw) ?? [])].filter(p => !isSamePath(p, fsPath));
+	list.push(fsPath);
+	return JSON.stringify(list.slice(-HPS_MAX_DENIED));
+}
+
+/** The denied list without `fsPath` (an explicit "Trust"). */
+export function hpsDeniedWithout(raw: string | undefined, fsPath: string, isSamePath: (a: string, b: string) => boolean): string {
+	return JSON.stringify((hpsDeniedOf(raw) ?? []).filter(p => !isSamePath(p, fsPath)));
+}
+
+export interface IHpsStudioTrustInput {
+	/** `inspect(HPS_STUDIO_FLAG).userLocalValue === true`, never a workspace or default value. */
+	readonly flagOn: boolean;
+	/** Raw `extensionsIdentifiers/disabled` from the PROFILE and the WORKSPACE scope; either disables the extension. */
+	readonly disabledExtensionsRaws: readonly (string | undefined)[];
+	/** Raw extension globalState blobs, in lookup order (PROFILE, APPLICATION). The first present record decides. */
+	readonly recordRaws: readonly (string | undefined)[];
+	/** Raw `HPS_STUDIO_DENIED_KEY` value. */
+	readonly deniedRaw: string | undefined;
+	readonly uri: { readonly scheme: string; readonly fsPath: string };
+	/** Current creation time of the folder (`fileService.stat().ctime`), undefined when not read. */
+	readonly birth: number | undefined;
+	/** Exact path equality (no parent, no child). */
+	readonly isSamePath: (a: string, b: string) => boolean;
+}
+
+/**
+ * True only for a local folder that Studio created: the user-local flag is on, the chat extension is
+ * not disabled, the learner never refused the folder, the folder is in the record exactly, and its
+ * creation time still matches the one recorded. Everything else keeps the normal trust prompt.
+ */
+export function hpsIsStudioCreatedFolder(input: IHpsStudioTrustInput): boolean {
+	if (!input.flagOn || input.uri.scheme !== 'file' || input.birth === undefined) {
+		return false;
+	}
+	if (input.disabledExtensionsRaws.some(hpsExtensionDisabled)) {
+		return false;
+	}
+	const denied = hpsDeniedOf(input.deniedRaw);
+	if (!denied || denied.some(p => input.isSamePath(p, input.uri.fsPath))) {
+		return false;
+	}
+	for (const raw of input.recordRaws) {
+		const folders = hpsStudioFolderRecordOf(raw);
+		if (folders) {
+			return folders.some(folder => input.isSamePath(folder.path, input.uri.fsPath) && folder.birth === input.birth);
+		}
+	}
+	return false;
+}
