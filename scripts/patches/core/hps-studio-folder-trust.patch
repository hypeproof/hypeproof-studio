+/*---------------------------------------------------------------------------------------------
+ *  HypeProof Studio (REQ-STUDIO-TRUST-OWN-FOLDERS) - folders Studio itself created are trusted.
+ *  Pure decision, no imports: the chat extension (`hypeproof.hypeproof-chat`) keeps the record in
+ *  its globalState; `workspaceTrust.ts` hands the stored JSON and an URI equality here.
+ *--------------------------------------------------------------------------------------------*/
+
+/** Key inside the extension's globalState blob. */
+export const HPS_STUDIO_FOLDERS_KEY = 'hypeproofChat.studioCreatedFolders';
+
+export interface IHpsStudioFolderRecord {
+	/** Off unless the default-off setting `hypeproofChat.trustStudioFolders` is on. */
+	readonly enabled: boolean;
+	/** Real paths of folders Studio created (never a folder it only found). */
+	readonly folders: readonly string[];
+}
+
+/** The record from the extension's stored globalState JSON; anything malformed is "no record". */
+export function hpsStudioFolderRecordOf(raw: string | undefined): IHpsStudioFolderRecord | undefined {
+	if (!raw) {
+		return undefined;
+	}
+	let record: { v?: unknown; enabled?: unknown; folders?: unknown } | undefined;
+	try {
+		record = JSON.parse(raw)?.[HPS_STUDIO_FOLDERS_KEY];
+	} catch {
+		return undefined;
+	}
+	if (!record || record.v !== 1 || record.enabled !== true || !Array.isArray(record.folders)) {
+		return undefined;
+	}
+	return { enabled: true, folders: record.folders.filter((p): p is string => typeof p === 'string' && p.length > 0) };
+}
+
+/**
+ * True only for a local folder that is in the record, exactly (no parent, no child, no name match),
+ * while the flag is on. Everything else keeps the normal trust prompt.
+ */
+export function hpsIsStudioCreatedFolder(
+	record: IHpsStudioFolderRecord | undefined,
+	uri: { readonly scheme: string; readonly fsPath: string },
+	isSamePath: (a: string, b: string) => boolean,
+): boolean {
+	if (!record || !record.enabled || uri.scheme !== 'file') {
+		return false;
+	}
+	return record.folders.some(folder => isSamePath(folder, uri.fsPath));
+}
