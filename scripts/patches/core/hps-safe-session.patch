+/**
+ * Studio (REQ-N11, persist:hp-safe) — may a safe session navigate to `url`?
+ *
+ * Always permitted: `file:`, `about:` and the learner's own loopback address
+ * (`localhost`, `127.0.0.1`, `[::1]`). Anything else must match an allowlist entry,
+ * with the same grammar as the chat extension's `hostAllowed`: a bare host
+ * (`example.org`, `*.example.org`, `.example.org`) admits that host and its
+ * subdomains; an entry with a scheme admits the same origin and that path prefix
+ * on a segment boundary (an origin-only entry admits every path). Entries are
+ * trimmed and case-insensitive, and a trailing-dot host matches like the plain
+ * host. A malformed entry admits nothing, so a bad list can only narrow access;
+ * an empty list confines the view to local pages.
+ */
+export function hpsSafeUrlAllowed(url: string, allowlist: readonly string[]): boolean {
+	let parsed: URL;
+	try {
+		parsed = new URL(url);
+	} catch {
+		return false;
+	}
+	if (parsed.protocol === 'file:' || parsed.protocol === 'about:') {
+		return true;
+	}
+	if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+		return false;
+	}
+	const host = parsed.hostname.toLowerCase().replace(/\.$/, '');
+	if (host === 'localhost' || host === '127.0.0.1' || host === '[::1]') {
+		return true;
+	}
+	for (const raw of allowlist) {
+		if (typeof raw !== 'string') {
+			continue;
+		}
+		const entry = raw.trim().toLowerCase();
+		if (!entry) {
+			continue;
+		}
+		if (entry.includes('://')) {
+			// Origin boundary: plain string prefixing would admit
+			// `https://ok.example.evil.com` and `https://ok.example@evil.com`.
+			let allowed: URL;
+			try {
+				allowed = new URL(entry);
+			} catch {
+				continue;
+			}
+			if (allowed.origin !== parsed.origin) {
+				continue;
+			}
+			const base = allowed.pathname.endsWith('/') ? allowed.pathname : `${allowed.pathname}/`;
+			if (allowed.pathname === '/' || parsed.pathname === allowed.pathname || parsed.pathname.startsWith(base)) {
+				return true;
+			}
+			continue;
+		}
+		const bare = entry.replace(/^\*?\./, '');
+		if (!bare || /[\/?#@\s]/.test(bare)) {
+			continue;
+		}
+		if (host === bare || host.endsWith(`.${bare}`)) {
+			return true;
+		}
+	}
+	return false;
+}
