+/* HypeProof RC profile contract. No Electron/keychain access in validation. */
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+export const RC_STORAGE_NAME = 'HypeProof Studio RC';
+export const RC_STORAGE_MARKER = '.hps-rc-profile-v1';
+interface RcArgs { 'user-data-dir'?: string; 'extensions-dir'?: string; 'use-inmemory-secretstorage'?: boolean; }
+interface RcProduct { version?: string; commit?: string; }
+export interface RcStorageProfile { appPath: string; profilePath: string; marker: string; }
+
+function refuse(reason: string): never {
+	throw new Error(`RC profile isolation blocked: ${reason}. Reinstall this exact RC kit; existing profiles are preserved.`);
+}
+
+function noSymlinks(home: string, target: string): void {
+	let current = home;
+	for (const component of path.relative(home, target).split(path.sep)) {
+		current = path.join(current, component);
+		try {
+			if (fs.lstatSync(current).isSymbolicLink()) { refuse('symlink in kit/profile path'); }
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code !== 'ENOENT') { throw error; }
+		}
+	}
+}
+
+// Later VS Code startup reparses process.argv independently of bootstrap's args.
+// Normalize only validated RC path options, before any positional '--' separator.
+function canonicalRcArgv(argv: string[], profilePath: string): string[] {
+	const paths: Record<string, string> = { 'user-data-dir': profilePath, 'extensions-dir': path.join(profilePath, 'extensions') };
+	const retained: string[] = [];
+	const seen = new Set<string>();
+	let positional: string[] = [];
+	for (let i = 0; i < argv.length; i++) {
+		const arg = argv[i];
+		if (i === 0) { retained.push(arg); continue; }
+		if (arg === '--') { positional = argv.slice(i); break; }
+		const key = Object.keys(paths).find(name => arg === `--${name}` || arg.startsWith(`--${name}=`) || arg === `--no-${name}` || arg.startsWith(`--no-${name}=`));
+		if (!key) { retained.push(arg); continue; }
+		if (seen.has(key) || arg.startsWith('--no-')) { refuse(`duplicate or negated ${key}`); }
+		seen.add(key);
+		const value = arg === `--${key}` ? argv[++i] : arg.slice(key.length + 3);
+		if (!value || value.startsWith('--') || path.resolve(value) !== paths[key]) { refuse(`${key} mismatch`); }
+	}
+	return [...retained, ...Object.entries(paths).map(([key, value]) => `--${key}=${value}`), ...positional];
+}
+
+// Select before argv.json is read. The marker is configuration, not authentication.
+// The only selectable OS encryption namespace is the fixed name above.
+export function prepareRcStorage(args: RcArgs, product: RcProduct, executable: string, home: string, platform: string, env: NodeJS.ProcessEnv, argv: string[]): RcStorageProfile | undefined {
+	if (platform !== 'darwin') { return undefined; }
+	const appPath = path.dirname(path.dirname(path.dirname(executable)));
+	const kit = path.dirname(appPath);
+	const applications = path.join(home, 'Applications');
+	const claimedKit = path.dirname(kit) === applications && path.basename(kit).startsWith('HypeProof-RC-');
+	const dedicatedRoot = path.join(home, 'Library', 'Application Support', 'HPS-RC-Profiles');
+	const claimedProfile = typeof args['user-data-dir'] === 'string' && (path.resolve(args['user-data-dir']) === dedicatedRoot || path.resolve(args['user-data-dir']).startsWith(dedicatedRoot + path.sep));
+	if (!claimedKit) {
+		if (claimedProfile) { refuse('dedicated RC profile requires its matching kit app'); }
+		return undefined; // A promoted app outside the kit retains production defaults.
+	}
+	const candidateVersion = path.basename(kit).slice('HypeProof-RC-'.length);
+	const version = product.version;
+	const source = product.commit;
+	if (!version || !/^\d+\.\d+\.\d+-[0-9A-Za-z.]+$/.test(candidateVersion) || (version !== candidateVersion && version !== candidateVersion.split('-')[0]) || !source || !/^[a-f0-9]{40}$/.test(source)) { refuse('invalid built version/source'); }
+	if (/[\r\n]/.test(home) || kit !== path.join(applications, `HypeProof-RC-${candidateVersion}`) || path.basename(appPath) !== 'HypeProof Studio.app') { refuse('kit app path/version mismatch'); }
+	const profilePath = path.join(dedicatedRoot, candidateVersion);
+	noSymlinks(home, appPath);
+	noSymlinks(home, profilePath);
+	const marker = ['hps-rc-profile-v1', RC_STORAGE_NAME, candidateVersion, version, source, appPath, profilePath, ''].join('\n');
+	for (const directory of [kit, profilePath]) {
+		const markerPath = path.join(directory, RC_STORAGE_MARKER);
+		try {
+			if (!fs.lstatSync(markerPath).isFile() || fs.lstatSync(markerPath).isSymbolicLink() || fs.readFileSync(markerPath, 'utf8') !== marker) { refuse('invalid profile marker'); }
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code === 'ENOENT') { refuse('missing profile marker'); }
+			throw error;
+		}
+	}
+	if (env['VSCODE_PORTABLE'] || env['VSCODE_APPDATA']) { refuse('portable/appdata override'); }
+	if (args['use-inmemory-secretstorage']) { refuse('in-memory secret storage is not a durable RC profile'); }
+	if (args['user-data-dir'] !== undefined && (typeof args['user-data-dir'] !== 'string' || !args['user-data-dir'] || path.resolve(args['user-data-dir']) !== profilePath)) { refuse('user-data-dir mismatch'); }
+	if (args['extensions-dir'] !== undefined && (typeof args['extensions-dir'] !== 'string' || !args['extensions-dir'] || path.resolve(args['extensions-dir']) !== path.join(profilePath, 'extensions'))) { refuse('extensions-dir mismatch'); }
+	const canonicalArgv = canonicalRcArgv(argv, profilePath);
+	args['user-data-dir'] = profilePath;
+	args['extensions-dir'] = path.join(profilePath, 'extensions');
+	argv.splice(0, argv.length, ...canonicalArgv);
+	return { appPath, profilePath, marker };
+}
+
+export function validateRcUserDataPath(profile: RcStorageProfile | undefined, resolvedUserDataPath: string): void {
+	if (profile && resolvedUserDataPath !== profile.profilePath) { refuse('resolved userDataPath mismatch'); }
+}
