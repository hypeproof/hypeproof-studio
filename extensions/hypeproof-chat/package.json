{
  "name": "hypeproof-chat",
  "displayName": "HypeProof Chat",
  "description": "Built-in chat panel for HypeProof Studio.",
  "version": "0.1.5",
  "publisher": "hypeproof",
  "engines": {
    "vscode": "^1.116.0"
  },
  "enabledApiProposals": [
    "browser"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The coach can run shell commands and resolve an SDK executable. In an untrusted workspace, the runtime/executable and gateway settings are ignored and every action still passes through the approval gate.",
      "restrictedConfigurations": [
        "hypeproofChat.sdkBinaryPath",
        "hypeproofChat.coachRuntime",
        "hypeproofChat.proxyUrl",
        "hypeproofChat.requireApprovalFor",
        "hypeproofChat.sdkSeedOnDemand",
        "hypeproofChat.freeStart"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypeproof-chat",
          "title": "대화",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "hypeproof-chat": [
        {
          "id": "hypeproof-chat.panel",
          "name": "대화",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "hypeproof-chat.takeMyWork", "title": "내 작업 가져가기", "enablement": "config.hypeproofChat.workTakeawayEnabled" },
      { "command": "hypeproof-chat.artifactHistory", "title": "이 파일의 이전 버전", "category": "HypeProof" },
      { "command": "hypeproof-chat.trashFile", "title": "파일을 활동 휴지통으로 이동", "enablement": "config.hypeproofChat.activityTrashEnabled" },
      { "command": "hypeproof-chat.activityTrash", "title": "활동 휴지통 열기", "enablement": "config.hypeproofChat.activityTrashEnabled" },
      {
        "command": "hypeproof-chat.focus",
        "title": "대화로 이동"
      },
      {
        "command": "hypeproof-chat.openBrowser",
        "title": "HypeProof: 브라우저 열기",
        "icon": "$(globe)"
      },
      {
        "command": "hypeproof-chat.sendPageToCoach",
        "title": "HypeProof: 현재 페이지를 코치에게 보내기",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hypeproof-chat.clearHistory",
        "title": "대화 지우기"
      },
      {
        "command": "hypeproof-chat.setToken",
        "title": "참여 코드 입력"
      },
      {
        "command": "hypeproof-chat.runLastCode",
        "title": "마지막 코드를 미리보기에서 실행"
      },
      {
        "command": "hypeproof-chat.renameCoach",
        "title": "HypeProof Chat: 코치 이름 다시 짓기"
      },
      {
        "command": "hypeproof-chat.reportProblem",
        "title": "HypeProof Chat: 문제 신고하기"
      },
      {
        "command": "hypeproof-chat.checkForUpdates",
        "title": "HypeProof Chat: 업데이트 확인"
      },
      {
        "command": "hypeproof-chat.installUpdate",
        "title": "HypeProof Chat: 업데이트 설치"
      },
      {
        "command": "hypeproof-chat.mintStudentToken",
        "title": "HypeProof Chat: 학생 토큰 발급 (강사용)"
      },
      {
        "command": "hypeproof-chat.forgetIssuerToken",
        "title": "HypeProof Chat: 저장된 issuer 토큰 지우기"
      },
      {
        "command": "hypeproof-chat.chalk.setInstructorToken",
        "title": "Chalk: 강사 토큰 입력"
      },
      {
        "command": "hypeproof-chat.chalk.checkPlan",
        "title": "Chalk: 초안 검사 (강사용)"
      },
      {
        "command": "hypeproof-chat.chalk.openCourse",
        "title": "Chalk: 강의 초안 열기 (강사용)"
      },
      {
        "command": "hypeproof-chat.chalk.savePlan",
        "title": "Chalk: 계획서 저장 (강사용)"
      },
      {
        "command": "hypeproof-chat.previewActiveFile",
        "title": "HypeProof: HTML 미리보기 (옆 패널)",
        "icon": "$(open-preview)"
      },
      {
        "command": "hypeproof-chat.uploadSessionLogs",
        "title": "HypeProof: 오늘 활동 기록 보내기"
      },
      {
        "command": "hypeproof-chat.previewViewport",
        "title": "HypeProof: 미리보기 화면 크기",
        "icon": "$(device-mobile)"
      },
      {
        "command": "hypeproof-chat.start",
        "title": "HypeProof: 시작 화면",
        "icon": "$(home)"
      },
      {
        "command": "hypeproof-chat.diagnoseVoiceCapability",
        "title": "HypeProof: 음성 기능 진단 (개발용)"
      },
      {
        "command": "hypeproof-chat.localReview",
        "title": "HypeProof: 나의 변화 기록"
      },
      {
        "command": "hypeproof-chat.classroomConnect",
        "title": "HypeProof: 수업 연결 (강사가 준 코드 입력)"
      },
      {
        "command": "hypeproof-chat.classroomDisconnect",
        "title": "HypeProof: 수업 연결 끊기"
      },
      {
        "command": "hypeproof-chat.classroomNotes",
        "title": "HypeProof: 강사가 보낸 질문·확인 지점 보기"
      },
      {
        "command": "hypeproof-chat.classroomCollectionConsent",
        "title": "HypeProof: 수업 기록 보내기 동의·철회"
      },
      {
        "command": "hypeproof-chat.classroomApproveArtifact",
        "title": "HypeProof: 지금 결과물을 수업 결과물로 승인·취소"
      },
      {
        "command": "hypeproof-chat.pickElement",
        "title": "HypeProof: 화면에서 요소 골라 코치에게 묻기",
        "icon": "$(inspect)",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.browserResults",
        "title": "HypeProof: 실험 브라우저 결과 기록 보기",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.testMyProduct",
        "title": "HypeProof: 내 제품 테스트하기",
        "icon": "$(beaker)",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.publishSite",
        "title": "HypeProof: 홈페이지 인터넷에 올리기",
        "icon": "$(cloud-upload)",
        "enablement": "hypeproof-chat.sitePublishEnabled"
      },
      {
        "command": "hypeproof-chat.publishSiteUnregister",
        "title": "HypeProof: 배포 등록 해제"
      },
      {
        "command": "hypeproof-chat.changeFolderAiPermission",
        "title": "HypeProof: 이 폴더의 AI 권한 바꾸기"
      },
      {
        "command": "hypeproof-chat.switchProject",
        "title": "HypeProof: 프로젝트 변경",
        "enablement": "hypeproof-chat.sitePublishEnabled"
      },
      {
        "command": "hypeproof-chat.publishTestVersion",
        "title": "HypeProof: 사용자 테스트용으로 공개하기",
        "icon": "$(globe)",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.experimentEvidence",
        "title": "HypeProof: 실험 증거 보기",
        "icon": "$(checklist)",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.ventureMemory",
        "title": "HypeProof: 프로젝트 기억 보기",
        "icon": "$(history)",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.wikiIngest",
        "title": "HypeProof: 팀 브레인에 정리하기",
        "icon": "$(notebook)",
        "enablement": "hypeproof-chat.learningWikiEnabled"
      },
      {
        "command": "hypeproof-chat.deckDraft",
        "title": "HypeProof: 팀 브레인으로 덱 만들기",
        "icon": "$(preview)",
        "enablement": "hypeproof-chat.learningWikiEnabled"
      },
      {
        "command": "hypeproof-chat.curriculumSkills",
        "title": "HypeProof: 커리큘럼 스킬",
        "icon": "$(lightbulb)",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.weeklyReview",
        "title": "HypeProof: 주간 리뷰",
        "icon": "$(calendar)",
        "enablement": "hypeproof-chat.curriculumRuntimeEnabled"
      },
      {
        "command": "hypeproof-chat.weeklyReviewDirector",
        "title": "HypeProof: 주간 리뷰 (디렉터)",
        "enablement": "hypeproof-chat.curriculumRuntimeDirector"
      },
      {
        "command": "hypeproof-chat.clearBrowserResultBytes",
        "title": "HypeProof: 저장된 실험 브라우저 화면 지우기",
        "enablement": "hypeproof-chat.crBrowserBytesStored"
      },
      {
        "command": "hypeproof-chat.openStudioFiles",
        "title": "HypeProof: 작업 파일 열기",
        "icon": "$(files)"
      },
      {
        "command": "hypeproof-chat.externalSkills",
        "title": "HypeProof: GitHub 지침 스킬",
        "icon": "$(book)"
      },
      {
        "command": "hypeproof-chat.editImage",
        "title": "HypeProof: 이미지 편집",
        "icon": "$(file-media)"
      },
      {
        "command": "hypeproof-chat.askAboutFile",
        "title": "이 파일에 대해 묻기"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hypeproof-chat.openStudioFiles",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@0"
        },
        {
          "command": "hypeproof-chat.openBrowser",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@1"
        },
        {
          "command": "hypeproof-chat.sendPageToCoach",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.pageContextEnabled",
          "group": "navigation@2"
        },
        {
          "command": "hypeproof-chat.previewViewport",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@3"
        },
        {
          "command": "hypeproof-chat.localReview",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@4"
        },
        {
          "command": "hypeproof-chat.pickElement",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.curriculumRuntimeEnabled",
          "group": "navigation@5"
        },
        {
          "command": "hypeproof-chat.publishSite",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.sitePublishEnabled",
          "group": "navigation@5"
        },
        {
          "command": "hypeproof-chat.testMyProduct",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.curriculumRuntimeEnabled",
          "group": "navigation@6"
        },
        {
          "command": "hypeproof-chat.publishTestVersion",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.curriculumRuntimeEnabled",
          "group": "navigation@7"
        },
        {
          "command": "hypeproof-chat.experimentEvidence",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.curriculumRuntimeEnabled",
          "group": "navigation@8"
        },
        {
          "command": "hypeproof-chat.ventureMemory",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.curriculumRuntimeEnabled",
          "group": "navigation@9"
        },
        {
          "command": "hypeproof-chat.curriculumSkills",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.curriculumRuntimeEnabled",
          "group": "navigation@10"
        },
        {
          "command": "hypeproof-chat.weeklyReview",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.curriculumRuntimeEnabled",
          "group": "navigation@11"
        },
        {
          "command": "hypeproof-chat.externalSkills",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@12"
        },
        {
          "command": "hypeproof-chat.editImage",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@13"
        }
      ],
      "editor/title": [
        {
          "command": "hypeproof-chat.openStudioFiles",
          "when": "activeWebviewPanelId == 'hypeproof.start'",
          "group": "navigation@0"
        },
        {
          "command": "hypeproof-chat.publishSite",
          "when": "activeWebviewPanelId == 'hypeproof.start' && hypeproof-chat.sitePublishEnabled",
          "group": "navigation@1"
        },
        {
          "command": "hypeproof-chat.previewActiveFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        },
        {
          "command": "hypeproof-chat.externalSkills",
          "when": "activeWebviewPanelId == 'hypeproof.start'",
          "group": "navigation@12"
        }
      ],
      "explorer/context": [
        { "command": "hypeproof-chat.artifactHistory", "when": "!explorerResourceIsFolder && resourceScheme == file", "group": "hypeproof@3" },
        { "command": "hypeproof-chat.trashFile", "when": "config.hypeproofChat.activityTrashEnabled && resourceScheme == file && workspaceFolderCount == 1", "group": "navigation@7" },
        {
          "command": "hypeproof-chat.previewActiveFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation@5"
        },
        {
          "command": "hypeproof-chat.askAboutFile",
          "when": "hypeproof-chat.askAboutFileEnabled && !explorerResourceIsFolder && resourceScheme == file && workspaceFolderCount == 1",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "hypeproof-chat.askAboutFile",
          "when": "false"
        },
        {
          "command": "hypeproof-chat.diagnoseVoiceCapability",
          "when": "false"
        },
        {
          "command": "hypeproof-chat.pickElement",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.browserResults",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.testMyProduct",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.publishTestVersion",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.publishSite",
          "when": "hypeproof-chat.sitePublishEnabled"
        },
        {
          "command": "hypeproof-chat.publishSiteUnregister",
          "when": "hypeproof-chat.sitePublishEnabled"
        },
        {
          "command": "hypeproof-chat.switchProject",
          "when": "hypeproof-chat.sitePublishEnabled"
        },
        {
          "command": "hypeproof-chat.experimentEvidence",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.ventureMemory",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.wikiIngest",
          "when": "hypeproof-chat.learningWikiEnabled"
        },
        {
          "command": "hypeproof-chat.deckDraft",
          "when": "hypeproof-chat.learningWikiEnabled"
        },
        {
          "command": "hypeproof-chat.curriculumSkills",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.weeklyReview",
          "when": "hypeproof-chat.curriculumRuntimeEnabled"
        },
        {
          "command": "hypeproof-chat.weeklyReviewDirector",
          "when": "hypeproof-chat.curriculumRuntimeDirector"
        },
        {
          "command": "hypeproof-chat.clearBrowserResultBytes",
          "when": "hypeproof-chat.crBrowserBytesStored"
        }
      ]
    },
    "configuration": {
      "title": "대화 설정",
      "properties": {
        "hypeproofChat.osTaskNotices": {
          "type": "boolean", "default": false,
          "description": "창을 보고 있지 않을 때 코치의 완료·승인 대기 알림을 운영체제에 표시합니다. 답변 내용은 보내지 않습니다."
        },
        "hypeproofChat.artifactHistoryEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "활동 파일의 이전 버전을 이 기기에 보관합니다. 수업·미성년자 활동도 기본은 꺼짐이며, 파일마다 최근 20개를 보관합니다."
        },
        "hypeproofChat.annotationBatchEnabled": {
          "type": "boolean", "default": false, "scope": "machine",
          "description": "미리보기 화면에 표시를 남겨 한꺼번에 보낼 수 있게 합니다. 수업에서 제공하는 실행 환경과 이미지 권한이 있어야 합니다. 기본은 꺼짐입니다."
        },
        "hypeproofChat.workTakeawayEnabled": {
          "type": "boolean", "default": false, "scope": "machine",
          "description": "활동이 바뀔 때 내 작업을 이 기기에 따로 저장해 둘 수 있게 합니다. 모든 이용 방식에서 기본은 꺼짐이며, 참여 코드나 AI 사용 권한은 옮기지 않습니다."
        },
        "hypeproofChat.activityTrashEnabled": {
          "type": "boolean", "default": false, "scope": "machine",
          "description": "활동 파일을 지울 때 암호화된 활동 휴지통에 보관합니다. 모든 이용 방식에서 기본은 꺼짐입니다. 키는 운영체제의 키 저장소에 보관하며 활동 폴더를 제거할 때 사본도 제거합니다. 사용 여부는 소유자가 결정합니다."
        },
        "hypeproofChat.proxyUrl": {
          "type": "string",
          "default": "https://api.hypeproof-ai.xyz/v1",
          "scope": "machine",
          "description": "코치가 연결할 서비스 주소입니다. 이 기기에만 적용하며 작업 폴더에서 바꿀 수 없습니다. 개발 환경에서만 변경하세요."
        },
        "hypeproofChat.freeStart": {
          "type": "string",
          "enum": ["service", "off"],
          "enumItemLabels": ["서비스 안내 따르기", "참여 코드로 시작"],
          "default": "service",
          "scope": "machine",
          "description": "처음 열 때 코드 없이 시작할지 정합니다. service는 서비스의 체험 안내를 따르고, off는 참여 코드 입력 화면을 표시합니다."
        },
        "hypeproofChat.model": {
          "type": "string",
          "default": "hypeproof-default",
          "description": "요청할 모델 이름입니다. 실제 모델은 수업 정책에 따라 서비스가 정합니다."
        },
        "hypeproofChat.coachRuntime": {
          "type": "string",
          "enum": [
            "proxy",
            "agent-sdk"
          ],
          "enumItemLabels": ["서비스 연결", "기기 에이전트"],
          "default": "proxy",
          "scope": "machine",
          "description": "코치 실행 방식입니다. proxy는 서비스 연결, agent-sdk는 이 기기의 에이전트 실행을 사용합니다. 이 기기에만 적용하며 작업 폴더에서 바꿀 수 없습니다."
        },
        "hypeproofChat.sdkBinaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "이 기기에서 사용할 에이전트 실행 파일의 전체 경로입니다. 비워 두면 환경 변수, 설치된 위치, 개발용 패키지 순으로 찾습니다. 작업 폴더에서 바꿀 수 없습니다."
        },
        "hypeproofChat.sdkSeedOnDemand": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "에이전트 실행 파일이 없으면 다운로드 여부를 물어봅니다. 이 앱에 고정된 검증값과 일치할 때만 설치합니다. 기본은 꺼짐이며 작업 폴더에서 바꿀 수 없습니다."
        },
        "hypeproofChat.sdkStallTimeoutMs": {
          "type": "number",
          "default": 240000,
          "minimum": 0,
          "scope": "machine",
          "description": "코치 응답을 기다릴 최대 시간(밀리초)입니다. 시간이 지나면 멈추고 다시 시도할 수 있게 안내합니다. 0은 대기 제한을 끕니다."
        },
        "hypeproofChat.requireApprovalFor": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "writeFile",
              "executeShell",
              "openBrowser",
              "delegateAgent",
              "browserType",
              "consultHelper"
            ]
          },
          "default": [
            "executeShell",
            "openBrowser",
            "delegateAgent",
            "browserType"
          ],
          "scope": "machine",
          "description": "실행 전에 확인을 받을 동작입니다. 이 기기에만 적용하며 작업 폴더에서 확인 절차를 약하게 바꿀 수 없습니다. 파일 쓰기는 기본 확인 목록에서 제외되지만 작업 폴더 밖 쓰기는 거부합니다. 도우미 상담을 추가하면 상담 전에도 확인합니다."
        },
        "hypeproofChat.siteBase": {
          "type": "string",
          "default": "https://hypeproof-ai.xyz",
          "description": "사이트 주소입니다. '갤러리에 올리기'가 여기로 보냅니다. 로컬 개발 서버에 붙여 볼 때만 바꾸세요 (예: http://localhost:3000). 아이 작품이 실제로 올라가는 목적지이므로 워크스페이스 설정이 아니라 머신 설정입니다 — proxyUrl 과 같은 범위입니다 (#748).",
          "scope": "machine"
        },
        "hypeproofChat.accountsEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "개인 계정으로 로그인할 수 있게 합니다. 공식 서비스와 계정 사이트에서만 적용합니다. 로컬 미리보기는 별도 설정입니다."
        },
        "hypeproofChat.publicUpdates": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "회원용 비공개 배포에 접근할 수 없을 때 공개 배포에서 업데이트를 확인합니다. 기본은 꺼짐이며 기존 회원 동작은 바뀌지 않습니다."
        },
        "hypeproofChat.accountsPreview": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "이 기기의 개인 계정 미리보기를 켭니다. 서비스와 계정 사이트가 모두 로컬 주소일 때만 사용할 수 있습니다."
        }
      }
