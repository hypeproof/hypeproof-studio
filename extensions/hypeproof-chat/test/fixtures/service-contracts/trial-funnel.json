{
  "schema": "studio-consumer-fixture/trial-funnel/1",
  "provenance": {
    "repository": "hypeproof/hypeproof-service",
    "branch": "feat/conv-funnel-events-first10",
    "commit": "03e225b",
    "note": "Captured from the Service branch commit by running its parseAppEvent (samples[].accepted is the real parser verdict). Regenerate when the Service contract changes.",
    "sources": {
      "worker/src/lib/trial-funnel.ts": "e5e326b27c8a208e45dc3c2b4e60a6ab9d13d3a18005d452500024e129d9875b",
      "worker/src/routes/trial-events.ts": "958c3d873e02d977265c94f97205237c1796a3b42ad04a599fab1ad6b5fe2a0c",
