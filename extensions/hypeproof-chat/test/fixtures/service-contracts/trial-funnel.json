  "route": {
    "mount": "/v1/trial",
    "path": "/v1/trial/events",
    "send": "POST",
    "discovery": "GET",
    "body_max_bytes": 2048,
    "top_level_keys": [
      "type",
      "fields"
    ]
  },
  "probe": {
    "status": 200,
    "body": {
      "schema": "hps-trial-funnel/1",
      "events": [
        "trial_entry",
        "trial_tool_result",
        "offer_viewed",
        "offer_clicked",
        "offer_dismissed"
      ]
    }
  },
  "probe_off": {
    "status": 404,
    "body": {
      "error": {
        "message": "not found",
        "type": "not_found"
      }
    }
  },
  "version_re": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,5}(?:-[0-9A-Za-z.]{1,16})?$",
  "app_events": {
    "trial_entry": {
      "outcome": {
        "kind": "enum",
        "values": [
          "granted",
          "reused",
          "signed_in"
        ],
        "required": true
      },
      "app_version": {
        "kind": "version",
        "required": false
      },
      "os": {
        "kind": "enum",
        "values": [
          "darwin",
          "win32",
          "linux"
        ],
        "required": false
      }
    },
    "trial_tool_result": {
      "kind": {
        "kind": "enum",
        "values": [
          "write",
          "edit",
          "preview",
          "publish"
        ],
        "required": true
      },
      "ok": {
        "kind": "bool",
        "required": true
      }
    },
    "offer_viewed": {
      "surface": {
        "kind": "enum",
        "values": [
          "end_card",
          "start_page"
        ],
        "required": true
      }
    },
    "offer_clicked": {
      "surface": {
        "kind": "enum",
        "values": [
          "end_card",
          "start_page"
        ],
        "required": true
      }
    },
    "offer_dismissed": {
      "surface": {
        "kind": "enum",
        "values": [
          "end_card",
          "start_page"
        ],
        "required": true
      }
    }
  },
